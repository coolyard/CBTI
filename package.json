{
  "name": "cbti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.24.0"
  },
  "description": "CBTI 角色人格指标 —— 测测你的灵魂被哪个角色附体了（H5 + 微信小程序）",
