    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020520260824002",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020520260824002",
    "@types/node": "^24.0.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.8.1",
    "sass": "^1.103.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "unocss": "^66.8.1",
    "vite": "5.2.8",
